# Public frontend URL (e.g. https://oasisamusementhub.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API base path (defaults to /api/v1 or http://localhost:4000/api/v1)
NEXT_PUBLIC_API_URL=/api/v1

# Google OAuth Web Client ID (for Sign in with Google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: internal backend origin used by Next.js /api/v1 rewrite proxy
# API_INTERNAL_URL=http://localhost:4000
